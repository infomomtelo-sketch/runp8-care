# Playwright screenshots from verification runs. These get written to the
# working directory when a test is run from the repo root; they are throwaway
# evidence, not project files.
*.png
!apple-touch-icon.png
!favicon-32.png
!icon-192.png
!icon-512.png

# Tello's home-screen icon is served by the site; *.png above would drop it.
!tello-apple-touch-icon.png

# Partner Tello's Worker installs the Anthropic SDK; the lockfile is committed.
workers/partner_tello/node_modules/
workers/partner_tello/.wrangler/

# Partner Tello's home-screen icon (/meet).
!partner_tello-apple-touch-icon.png
